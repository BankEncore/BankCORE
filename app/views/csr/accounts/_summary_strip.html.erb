<div class="card receipt-section bg-base-100 border border-base-300 mb-4">
  <div class="card-body py-3">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <div class="text-base-content/60">Ledger</div>
        <div class="font-semibold tabular-nums <%= account.balance_cents.negative? ? 'text-error' : '' %>">
          <%= number_to_currency(account.balance_cents / 100.0) %>
        </div>
        <% as_of = account.ledger_balance_updated_at %>
        <div class="text-xs text-base-content/50">
          Latest transaction: <%= as_of.present? ? as_of.strftime("%b %-d, %y %-l:%M%P") : "—" %>
        </div>
      </div>
    </div>
  </div>
</div>
