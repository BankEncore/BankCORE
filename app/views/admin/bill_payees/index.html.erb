<%= render "admin/shared/page_header",
  title: "Bill Payees",
  description: "Manage bill payees for teller bill payment transactions.",
  primary_button_path: new_admin_bill_payee_path,
  primary_button_label: "Add Bill Payee" %>

<section class="card bg-base-100 border border-base-300">
  <div class="card-body">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Liability Account</th>
            <th>Default Fee</th>
            <th>Order</th>
            <th>Memo Req.</th>
            <th>Active</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @bill_payees.each do |bp| %>
            <tr>
              <td><%= bp.code %></td>
              <td><%= bp.name %></td>
              <td><%= bp.liability_account_reference %></td>
              <td><%= bp.default_fee_amount_cents ? number_to_currency(bp.default_fee_amount_cents / 100.0) : "—" %></td>
              <td><%= bp.display_order %></td>
              <td><%= bp.memo_required? ? "Yes" : "No" %></td>
              <td><%= bp.is_active? ? "Yes" : "No" %></td>
              <td class="text-right">
                <%= link_to "Edit", edit_admin_bill_payee_path(bp), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
