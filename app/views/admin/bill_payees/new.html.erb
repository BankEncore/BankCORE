<%= render "admin/shared/page_header",
  title: "New Bill Payee",
  description: "Add a bill payee for teller bill payment transactions.",
  secondary_button_path: admin_bill_payees_path,
  secondary_button_label: "Back" %>

<%= form_with model: @bill_payee, url: admin_bill_payees_path, class: "card bg-base-100 border border-base-300" do |f| %>
  <div class="card-body">
    <%= render "admin/bill_payees/form", f: f %>

    <div class="form-control mt-4">
      <%= f.submit "Create Bill Payee", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
