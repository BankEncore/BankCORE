<%= render "admin/shared/page_header",
  title: "Edit Linked Fee",
  description: "Update linked fee settings.",
  secondary_button_path: admin_transaction_misc_receipt_defaults_path,
  secondary_button_label: "Back" %>

<%= form_with model: @transaction_misc_receipt_default, url: admin_transaction_misc_receipt_default_path(@transaction_misc_receipt_default), method: :patch, class: "card bg-base-100 border border-base-300" do |f| %>
  <div class="card-body">
    <%= render "admin/transaction_misc_receipt_defaults/form", f: f %>

    <div class="form-control mt-4">
      <%= f.submit "Update Linked Fee", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
