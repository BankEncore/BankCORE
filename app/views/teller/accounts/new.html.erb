<%= render "teller/shared/page_header",
  title: "New Account",
  description: "Create an account for #{@branch.name}. Add at least one owner.",
  secondary_button_path: teller_accounts_path,
  secondary_button_label: "Back to Accounts" %>

<section class="card bg-base-100 border border-base-300">
  <div class="card-body">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="card-title text-base">New Account</h2>
        <p class="text-xs text-base-content/70 mt-1">Create an account for <%= @branch.name %>. Add at least one owner.</p>
      </div>
    </div>
    <div class="divider my-3"></div>

    <%= form_with url: teller_accounts_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <%= hidden_field_tag "account[branch_id]", @branch.id %>

      <% if @account&.errors&.any? %>
        <div class="alert alert-error">
          <ul class="list-disc list-inside">
            <% @account.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= label_tag "account[account_number]", "Account number", class: "text-xs font-medium text-base-content" %>
          <%= text_field_tag "account[account_number]", @account&.account_number, class: "input input-bordered w-full", maxlength: 16, placeholder: "e.g. 1234567890123456", required: true %>
        </div>
        <div class="form-control">
          <%= label_tag "account[account_type]", "Account type", class: "text-xs font-medium text-base-content" %>
          <%= select_tag "account[account_type]", options_for_select(Account::ACCOUNT_TYPES.map { |k| [ k.titleize, k ] }, @account&.account_type || "checking"), class: "select select-bordered w-full" %>
        </div>
      </div>

      <%= hidden_field_tag "account[opened_on]", Date.current.strftime("%Y-%m-%d") %>
      <%= hidden_field_tag "account[status]", "open" %>

      <div class="divider my-3"></div>

      <h3 class="font-medium text-sm">Owners</h3>
      <p class="text-xs text-base-content/70 mt-1">Select at least one party as owner. Mark one as primary.</p>
      <div class="form-control">
        <%= render "shared/party_search_field",
          search_url: search_teller_parties_path,
          field_name: "account[primary_party_id]",
          field_value: @default_owner_party&.id || params.dig(:account, :primary_party_id) || params[:party_id],
          display_value: @default_owner_party&.display_name,
          label: "Primary owner",
          placeholder: "Search by name or phone" %>
      </div>
      <div class="form-control" data-controller="additional-owners">
        <%= label_tag nil, "Additional owners (optional)", class: "text-xs font-medium text-base-content block" %>
        <div data-additional-owners-target="list" class="space-y-1 mb-2"></div>
        <div data-additional-owners-target="searchWrapper">
          <%= render "shared/party_search_field",
            search_url: search_teller_parties_path,
            field_name: "account[_additional_pending]",
            placeholder: "Search to add another owner",
            context: "additional" %>
        </div>
      </div>

      <div class="divider my-3"></div>

      <div class="flex gap-2">
        <%= submit_tag "Create Account", class: "btn btn-primary" %>
        <%= link_to "Cancel", teller_accounts_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</section>
