<% mode = local_assigns.fetch(:mode, "optional") %>
<% return if mode.to_s == "hidden" %>

<% denominations = local_assigns.fetch(:denominations) { CashDenomination.enabled_for_display } %>
<% field_name = local_assigns.fetch(:field_name, "amount_cents") %>
<% expected_cents = local_assigns.fetch(:expected_cents, 0) %>
<% form = local_assigns[:form] %>
<% modal_id = local_assigns.fetch(:modal_id, "cash-count-modal-#{field_name.to_s.parameterize}") %>
<% omit_amount_from_hidden = local_assigns.fetch(:omit_amount_from_hidden, true) %>
<%# Only session open/close use native form submit and need hidden fields. Vault/deposit/withdrawal use JS FormData + appendDenominationLines. %>
<% use_hidden_fields = local_assigns.fetch(:use_hidden_fields, false) %>

<% catalog_json = denominations.map { |d|
  {
    id: d.id,
    code: d.code,
    kind: d.kind,
    face_value_cents: d.face_value_cents,
    roll_value_cents: d.roll_value_cents,
    display_label: d.display_label,
    sort_order: d.sort_order
  }
}.to_json %>

<dialog
  id="<%= modal_id %>"
  data-cash-count-modal-target="dialog"
  aria-labelledby="<%= modal_id %>-title"
  class="modal"
  data-action="close->cash-count-modal#cancel"
>
    <div class="modal-box flex flex-col max-h-[min(32rem,calc(100vh-2rem))] overflow-hidden p-0 !w-[min(48rem,calc(100vw-2rem))]">
      <div class="p-5 flex-shrink-0">
        <h2 id="<%= modal_id %>-title" class="font-semibold text-lg">Cash count by denomination</h2>
        <p class="text-sm text-base-content/70 mt-1">Enter quantities for each denomination. Total is calculated automatically.</p>
      </div>

      <div
        class="flex-1 min-h-0 flex flex-col"
        data-controller="denomination-entry"
        data-cash-count-modal-target="denominationEntry"
        data-denomination-entry-catalog-value="<%= h(catalog_json) %>"
        data-denomination-entry-mode-value="<%= mode %>"
        data-denomination-entry-expected-cents-value="<%= expected_cents %>"
        data-denomination-entry-field-name-value="<%= field_name %>"
        data-denomination-entry-omit-amount-from-hidden-value="<%= omit_amount_from_hidden %>"
      >
        <div class="flex-1 min-h-0 overflow-y-auto px-5">
          <div class="rounded-lg border border-base-300 bg-base-200 p-3">
            <div data-denomination-entry-target="rowsContainer" class="min-h-[4rem]"></div>
          </div>
        </div>
        <div class="flex-shrink-0 px-5 pt-3 pb-2 border-t border-base-300 bg-base-100">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm">
            <div class="ui-kv-row">
              <dt class="ui-kv-key text-xs">Bills</dt>
              <dd class="ui-kv-value mono" data-denomination-entry-target="billsSubtotal">$0.00</dd>
            </div>
            <div class="ui-kv-row">
              <dt class="ui-kv-key text-xs">Loose</dt>
              <dd class="ui-kv-value mono" data-denomination-entry-target="looseSubtotal">$0.00</dd>
            </div>
            <div class="ui-kv-row">
              <dt class="ui-kv-key text-xs">Rolled</dt>
              <dd class="ui-kv-value mono" data-denomination-entry-target="rolledSubtotal">$0.00</dd>
            </div>
            <div class="ui-kv-row">
              <dt class="ui-kv-key text-xs font-medium">Total</dt>
              <dd class="ui-kv-value mono font-medium" data-denomination-entry-target="grandTotal">$0.00</dd>
            </div>
          </div>
          <div class="mt-2 text-xs">
            <span class="text-base-content/70">Difference:</span>
            <span data-denomination-entry-target="differenceDisplay" class="tabular-nums"></span>
          </div>
          <% if use_hidden_fields %>
            <div data-denomination-entry-target="hiddenFieldsContainer" class="hidden-fields-container"></div>
          <% end %>
        </div>
      </div>

      <div class="modal-action flex-shrink-0 p-5 pt-0 border-t border-base-200 mt-0 flex-col items-end gap-2">
        <p class="text-error text-sm w-full text-right hidden" data-cash-count-modal-target="applyError" role="alert">Count must match expected payout.</p>
        <div class="flex gap-2 w-full justify-end">
          <button type="button" class="btn btn-ghost" data-action="click->cash-count-modal#cancel">Cancel</button>
          <button type="button" class="btn btn-primary" data-action="click->cash-count-modal#apply">Apply</button>
        </div>
      </div>
    </div>
    <div class="modal-backdrop" data-action="click->cash-count-modal#cancel" role="button" tabindex="-1" aria-label="Close dialog"></div>
</dialog>
