<% mode = local_assigns.fetch(:mode, "optional") %>
<% return if mode.to_s == "hidden" %>

<% denominations = local_assigns.fetch(:denominations) { CashDenomination.enabled_for_display } %>
<% field_name = local_assigns.fetch(:field_name, "amount_cents") %>
<% expected_cents = local_assigns.fetch(:expected_cents, 0) %>
<% wfc = local_assigns.fetch(:workflow_form_controller, "posting-form") %>
<% form = local_assigns[:form] %>

<% catalog_json = denominations.map { |d|
  {
    id: d.id,
    code: d.code,
    kind: d.kind,
    face_value_cents: d.face_value_cents,
    roll_value_cents: d.roll_value_cents,
    display_label: d.display_label,
    sort_order: d.sort_order
  }
}.to_json %>

<div
  class="mt-3 rounded-lg border border-base-300 bg-base-200 p-3"
  data-controller="denomination-entry"
  data-denomination-entry-catalog-value="<%= h(catalog_json) %>"
  data-denomination-entry-mode-value="<%= mode %>"
  data-denomination-entry-expected-cents-value="<%= expected_cents %>"
  data-denomination-entry-field-name-value="<%= field_name %>"
  <%= "data-action=\"denomination:change->#{wfc}#onDenominationChange\"".html_safe if wfc.present? && wfc != "session-close" %>
>
  <div class="font-medium text-sm mb-2">Cash by denomination</div>
  <div data-denomination-entry-target="rowsContainer" class="min-h-[4rem]">
    <%# Rows rendered by Stimulus %>
  </div>
  <div class="mt-3 pt-3 border-t border-base-300 grid grid-cols-2 md:grid-cols-4 gap-2 text-sm">
    <div class="ui-kv-row">
      <dt class="ui-kv-key text-xs">Bills</dt>
      <dd class="ui-kv-value mono" data-denomination-entry-target="billsSubtotal">$0.00</dd>
    </div>
    <div class="ui-kv-row">
      <dt class="ui-kv-key text-xs">Loose</dt>
      <dd class="ui-kv-value mono" data-denomination-entry-target="looseSubtotal">$0.00</dd>
    </div>
    <div class="ui-kv-row">
      <dt class="ui-kv-key text-xs">Rolled</dt>
      <dd class="ui-kv-value mono" data-denomination-entry-target="rolledSubtotal">$0.00</dd>
    </div>
    <div class="ui-kv-row">
      <dt class="ui-kv-key text-xs font-medium">Total</dt>
      <dd class="ui-kv-value mono font-medium" data-denomination-entry-target="grandTotal">$0.00</dd>
    </div>
  </div>
  <% if expected_cents.to_i.positive? %>
    <div class="mt-2 text-xs">
      <span class="text-base-content/70">Difference:</span>
      <span data-denomination-entry-target="differenceDisplay" class="tabular-nums"></span>
    </div>
  <% end %>
  <% if form %>
    <%# For transaction forms, parent syncs via denomination:change. For session close, we need hidden fields. %>
    <div data-denomination-entry-target="hiddenFieldsContainer" class="hidden-fields-container"></div>
  <% else %>
    <input type="hidden" name="<%= field_name %>" value="0" data-denomination-entry-target="totalOutput" />
  <% end %>
</div>
